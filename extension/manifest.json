{
  "manifest_version": 3,
  "name": "Saamba meeting detector",
  "version": "0.4.0",
  "description": "Detect when you join Google Meet and offer Saamba recording controls.",
  "host_permissions": [
    "https://meet.google.com/*",
    "http://127.0.0.1:24917/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://meet.google.com/*"
      ],
      "js": [
        "meet.js",
        "meet-control.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "http://127.0.0.1:24917/*"
      ],
      "js": [
        "saamba-bridge.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "permissions": [
    "activeTab",
    "tabCapture",
    "tabs"
  ],
  "action": {
    "default_title": "Start Saamba recording",
    "default_icon": {
      "16": "icon16.png",
      "32": "icon32.png",
      "128": "icon128.png"
    }
  },
  "icons": {
    "16": "icon16.png",
    "32": "icon32.png",
    "128": "icon128.png"
  }
}
